# Watson Orchestrate Configuration
# Copy this file to .env and fill in your actual values

# Watson Orchestrate Instance URL (includes /instances/{instance_id})
# Get from: IBM Cloud Console → Watson Orchestrate → Instance URL
WXO_INSTANCE_URL=https://api.eu-gb.watson-orchestrate.cloud.ibm.com/instances/YOUR_INSTANCE_ID

# IBM Cloud API Key
# Get from: IBM Cloud Console → Manage → Access (IAM) → API keys
WXO_API_KEY=YOUR_IBM_CLOUD_API_KEY

# Watson Orchestrate Agent ID
# Get from: Watson Orchestrate Console → Your Agent → Settings
WXO_AGENT_ID=YOUR_AGENT_ID

# Watson Orchestrate Environment ID
# Get from: Watson Orchestrate Console → Environment Settings
WXO_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID